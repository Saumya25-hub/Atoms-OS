#ifndef _LIBCPP_CHRONO
#define _LIBCPP_CHRONO

#include <stdint.h>
#include "../../c/include/time.h"

namespace std {
namespace chrono {

template <typename Rep, typename Period = void>
struct duration {
    Rep __r;
    constexpr duration() : __r(0) {}
    constexpr explicit duration(const Rep &r) : __r(r) {}
    constexpr Rep count() const { return __r; }
};

typedef duration<int64_t> nanoseconds;
typedef duration<int64_t> microseconds;
typedef duration<int64_t> milliseconds;
typedef duration<int64_t> seconds;

struct high_resolution_clock {
    struct time_point {
        nanoseconds __d;
        constexpr time_point(nanoseconds d) : __d(d) {}
        nanoseconds time_since_epoch() const { return __d; }
    };

    static time_point now() noexcept {
        struct timespec ts;
        clock_gettime(CLOCK_MONOTONIC, &ts);
        int64_t ns = (int64_t)ts.tv_sec * 1000000000LL + (int64_t)ts.tv_nsec;
        return time_point(nanoseconds(ns));
    }
};

typedef high_resolution_clock steady_clock;
typedef high_resolution_clock system_clock;

} // namespace chrono
} // namespace std

#endif /* _LIBCPP_CHRONO */
