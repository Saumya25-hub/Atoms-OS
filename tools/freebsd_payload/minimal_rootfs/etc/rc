#!/bin/sh
#
# Minimal /etc/rc for Atoms OS Hypervisor FreeBSD Environment (Stage D0)
#
HOME=/
PATH=/sbin:/bin:/usr/sbin:/usr/bin
export HOME PATH

# Mount writable in-memory tmpfs on /var for runtime DHCP PID & lease storage
/sbin/mount -t tmpfs tmpfs /var

# Ensure runtime directories exist and have proper permissions
/bin/mkdir -p /var/run/dhclient /var/db /var/empty /var/log
/bin/chmod 755 /var /var/run /var/run/dhclient /var/db /var/log
/bin/chmod 555 /var/empty

echo ""
echo "=================================================================="
echo "    ATOMS TYPE-1 HYPERVISOR -- FREEBSD 14.1-RELEASE LIVE SHELL   "
echo "=================================================================="
echo "  Host: Atoms OS Bare-Metal Micro-Hypervisor"
echo "  Guest: FreeBSD 14.1-RELEASE amd64 (GENERIC)"
echo "  Root Disk: /dev/vtbd0 (UFS2 Minimal Fast File System)"
echo "=================================================================="
echo ""

echo "--- [DIAG 1: KERNEL CONSOLE & DMESG INPUT DEVICES] ---"
sysctl kern.console
dmesg | grep -iE 'atkbd|kbd|uart|isa|acpi'

echo "--- [DIAG 2: DEVINFO RESOURCE TREE] ---"
devinfo -rv | grep -iE 'atkbd|uart|isa|acpi|pci'

echo "--- [DIAG 3: PCICONF LIST] ---"
pciconf -lv

echo "--- [DIAG 4: VMSTAT INTERRUPT TABLE] ---"
vmstat -i

echo "--- [DIAG 5: KBDCONTROL STATUS] ---"
kbdcontrol -i < /dev/console 2>&1

echo "--- [DIAG 6: VIRTIO-NET INTERFACE INITIALIZATION] ---"
if [ -x /sbin/ifconfig ]; then
    /sbin/ifconfig vtnet0 up
    /sbin/ifconfig vtnet0
fi

if [ -x /sbin/dhclient ]; then
    echo "Starting background DHCP client on vtnet0..."
    /sbin/dhclient vtnet0 > /dev/null 2>&1 &
fi

echo "=================================================================="
echo "  STAGE D0 DIAGNOSTICS COMPLETED -- READY FOR SHELL"
echo "=================================================================="

exec /bin/sh
