# Disable floppy
floppy0.present = "FALSE"

# VESA Compatible Display Settings
svga.present = "TRUE"
svga.vramSize = "134217728"
svga.maxWidth = "1920"
svga.maxHeight = "1080"

# Sound Device - Intel AC97
sound.present = "TRUE"
sound.virtualDev = "sb16"
sound.fileName = "-1"
sound.autodetect = "TRUE"

# PS/2 Mouse & Keyboard / Backdoor Absolute Mouse Integration
vmmouse.present = "TRUE"

# Standard PCI Controllers
